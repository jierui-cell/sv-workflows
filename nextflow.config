manifest {
    name = 'sv-workflows'
    description = 'Paired SV calling and independently selectable SV signature workflows'
    version = '0.1.0-dev'
    nextflowVersion = '25.10.7'
}
params {
    slurm_account = null
    slurm_partition = null
    account = null
    partition = null
    scheduler_options = ''
    modules_samtools = null
    modules_bcftools = null
    modules_calling = null
    max_parallel_preflight = 3
    max_parallel_callers = 3
    compact_publish = false
}
process {
    executor = 'local'
    errorStrategy = 'finish'
    maxErrors = '-1'
    scratch = false
    shell = ['/bin/bash', '-euo', 'pipefail']
}
executor.queueSize = 24
profiles {
    local { process.executor = 'local' }
    slurm {
        process.executor = 'slurm'
        process.queue = { params.slurm_partition ?: params.partition }
        process.clusterOptions = { "${(params.slurm_account ?: params.account) ? '--account=' + (params.slurm_account ?: params.account) : ''} ${params.scheduler_options}".trim() }
    }
    pbs {
        process.executor = 'pbs'
        process.queue = { params.partition ?: params.slurm_partition }
        process.clusterOptions = { params.scheduler_options }
    }
    lsf {
        process.executor = 'lsf'
        process.queue = { params.partition ?: params.slurm_partition }
        process.clusterOptions = { params.scheduler_options }
    }
    sge {
        process.executor = 'sge'
        process.queue = { params.partition ?: params.slurm_partition }
        process.clusterOptions = { params.scheduler_options }
    }
    test {
        process.executor = 'local'
        process.cpus = 1
        process.memory = '1 GB'
        process.time = '5m'
        executor.queueSize = 2
    }
}
